# Trakt OAuth (зарегистрированное приложение https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# TMDB — на старте используем тот же ключ, что в Lampa-ядре
TMDB_API_KEY=4ef0d7355d9ffb5151e987764708ce96
TMDB_LANG=ru-RU

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Sync
# На тесте 5 сек, в проде 60+
SYNC_POLL_INTERVAL_SEC=5

# Access code — общий семейный код доступа к API. Если задан, сервер требует
# заголовок X-Trakt-Code на всех /api/* кроме /api/health. Пусто = гейт выключен.
ACCESS_CODE=
